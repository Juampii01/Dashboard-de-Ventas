# Variables que necesita la app. Copia este archivo como .env.local (local)
# o ponlas en Vercel → Settings → Environment Variables (producción).
# Están en Supabase → Project Settings → API Keys.

# Dirección del proyecto de Supabase (p. ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (empieza por sb_publishable_). Solo se usa para iniciar sesión.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (empieza por sb_secret_). Da acceso total: nunca la compartas ni la subas a GitHub.
SUPABASE_SECRET_KEY=
